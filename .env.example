# Effort&Habit — variables de entorno (Vite)
# Copiar a `.env.local` en desarrollo. En Vercel: Settings → Environment Variables.

# URL base del backend real (sin barra final).
# Si NO está definida:
#   - en desarrollo se usa http://localhost:3001/api
#   - en producción se usa el mismo origen ('')
VITE_API_BASE_URL=

# Cambiar a 'false' cuando exista backend real conectado.
# Default (cualquier valor distinto de 'false') = modo MOCK (datos ficticios).
# IMPORTANTE: el valor debe ser exactamente el string 'false' para salir del modo mock.
VITE_USE_MOCK_API=true
